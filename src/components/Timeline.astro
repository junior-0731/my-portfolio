---
import Tx from "./Tx.astro";
import { ui } from "@/data/portfolio";
import { experiencia, formacion, ui2 } from "@/data/casos";
---
<section class="path" id="trayectoria" data-gl="dim" aria-labelledby="path-title">
  <div class="path-head">
    <Tx class="eyebrow mono" as="div" t={ui.pEyebrow} />
    <Tx as="h2" class="h2" id="path-title" html t={ui.pTitle} />
  </div>
  <div class="groups">
    <div class="grp">
      <Tx as="h3" class="mono gt" t={ui2.pExp} />
      <ol class="tl">
        {experiencia.map((e) => (
          <li data-reveal>
            <Tx class="yr mono" t={e.when} />
            <div><Tx as="b" t={e.role} /><small>{e.org}</small><Tx as="p" t={e.desc} /></div>
          </li>
        ))}
      </ol>
    </div>
    <div class="grp">
      <Tx as="h3" class="mono gt" t={ui2.pEdu} />
      <ol class="tl">
        {formacion.map((e) => (
          <li data-reveal>
            <Tx class="yr mono" t={e.when} />
            <div><Tx as="b" t={e.title} /><small>{e.org}</small><Tx as="p" t={e.desc} /></div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .path { padding: 16vh var(--gutter); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 48px; background: var(--carbon); position: relative; z-index: 1 }
  .path-head { position: sticky; top: 120px; align-self: start }
  .groups { display: grid; gap: 56px }
  .gt { color: var(--ink); font-weight: 600; font-size: 13px; display: flex; align-items: center; gap: 12px; margin-bottom: 14px }
  .gt::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--amber); box-shadow: 0 0 10px var(--amber) }
  .tl { list-style: none; border-top: 1px solid var(--line) }
  .tl li { display: grid; grid-template-columns: 150px 1fr; gap: 20px; padding: 24px 0; border-bottom: 1px solid var(--line) }
  .tl :global(.yr) { color: var(--amber) }
  .tl :global(b) { display: block; font-family: var(--display); font-weight: 700; font-size: 30px; text-transform: uppercase; line-height: 1 }
  .tl small { display: block; color: var(--titanium); font-size: 14px; margin-top: 4px }
  .tl :global(p) { color: var(--dim); font-size: 15px; margin-top: 8px; max-width: 58ch }
  @media (max-width: 980px) { .path { grid-template-columns: 1fr } .path-head { position: static } }
  @media (max-width: 640px) { .tl li { grid-template-columns: 1fr; gap: 6px } }
</style>
