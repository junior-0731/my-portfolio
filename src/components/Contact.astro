---
import Tx from "./Tx.astro";
import { site, ui } from "@/data/portfolio";
import { whatsapp, ui2 } from "@/data/casos";
const { email, linkedin, github } = site.contact;
const wa = `https://wa.me/${whatsapp.number}?text=${encodeURIComponent(whatsapp.text.es)}`;
const waEn = `https://wa.me/${whatsapp.number}?text=${encodeURIComponent(whatsapp.text.en)}`;
---
<section class="contact" id="contacto" data-gl="contact" aria-labelledby="contact-title">
  <Tx class="eyebrow mono" as="div" t={ui.ctEyebrow} />
  <Tx as="h2" class="h2" id="contact-title" html t={ui.ctTitle} />

  <!-- botón de mensaje: abre WhatsApp con un mensaje listo -->
  <a class="magnet" id="magnet" href={wa} data-href-es={wa} data-href-en={waEn} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
    <span class="ring" aria-hidden="true"></span>
    <svg class="bubble" viewBox="0 0 48 48" aria-hidden="true">
      <path d="M24 7c-10 0-18 6.9-18 15.6 0 4.6 2.3 8.8 6 11.6l-1.6 6.6a1 1 0 0 0 1.5 1.1l7.2-4.2c1.6.4 3.2.6 4.9.6 10 0 18-6.9 18-15.7S34 7 24 7Z" />
      <circle class="dot d1" cx="16.5" cy="22.6" r="2.2" /><circle class="dot d2" cx="24" cy="22.6" r="2.2" /><circle class="dot d3" cx="31.5" cy="22.6" r="2.2" />
    </svg>
    <span class="mono label">{ui2.waBtn.es}</span>
  </a>

  <div class="links mono">
    {linkedin && <a href={linkedin} target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4v11H3v-11Zm6.5 0h3.8v1.5h.06c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.77 2.65 4.77 6.1v5.45h-4v-4.83c0-1.15-.02-2.63-1.6-2.63-1.6 0-1.85 1.25-1.85 2.55v4.91h-4v-11Z" /></svg><span>LinkedIn</span></a>}
    {github && <a href={github} target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.15-1.1-1.46-1.1-1.46-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.08.63-1.33-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.56 9.56 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" /></svg><span>GitHub</span></a>}
    {email && <button type="button" class="copy" data-email={email} aria-live="polite"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18v14H3V5Zm2 2v.5l7 4.6 7-4.6V7H5Zm14 2.9-7 4.6-7-4.6V17h14V9.9Z" /></svg><Tx class="lbl" t={ui2.copyMail} data-done-es={ui2.copied.es} data-done-en={ui2.copied.en} /></button>}
    <a href="#cv"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2h9l5 5v15H6V2Zm8 1.5V8h4.5L14 3.5ZM9 12h8v1.5H9V12Zm0 3h8v1.5H9V15Zm0 3h5v1.5H9V18Z" /></svg><Tx t={ui2.heroCv} /></a>
  </div>
  {email && <p class="mail mono">{email}</p>}
</section>

<footer class="sitefoot mono">
  <span><Tx t={ui.foot} /> · {new Date().getFullYear()}</span>
  <span>Astro · GSAP · Lenis</span>
</footer>

<style>
  .contact { min-height: 100svh; display: grid; align-content: center; justify-items: center; text-align: center; padding: 14vh var(--gutter) 6vh; gap: 34px; position: relative; z-index: 1 }
  .contact :global(.h2) { font-size: clamp(56px, 10vw, 168px) }
  .magnet { position: relative; display: inline-grid; place-items: center; width: clamp(140px, 15vw, 176px); aspect-ratio: 1; border-radius: 50%; text-decoration: none; background: radial-gradient(120% 120% at 30% 20%, #f0b469, var(--amber) 55%, #b9732b); color: var(--carbon); box-shadow: 0 18px 50px -18px rgba(227, 154, 69, .65), inset 0 1px 0 rgba(255, 255, 255, .35); transition: transform .4s var(--ease-out), box-shadow .4s }
  .magnet:hover { box-shadow: 0 24px 70px -16px rgba(227, 154, 69, .85), inset 0 1px 0 rgba(255, 255, 255, .4) }
  .magnet .ring { position: absolute; inset: -10px; border-radius: 50%; border: 1px solid rgba(227, 154, 69, .45); animation: ring 2.8s ease-out infinite; pointer-events: none }
  .magnet .bubble { width: 44%; height: auto; margin-top: -10%; fill: var(--carbon); transition: transform .45s var(--ease-out) }
  .magnet .bubble .dot { fill: var(--amber); animation: typing 1.4s ease-in-out infinite }
  .magnet .bubble .d2 { animation-delay: .18s } .magnet .bubble .d3 { animation-delay: .36s }
  .magnet:hover .bubble { transform: translateY(-3px) rotate(-6deg) scale(1.06) }
  .magnet .label { position: absolute; bottom: 22%; font-weight: 600; letter-spacing: .08em }
  @keyframes ring { 0% { transform: scale(.92); opacity: .9 } 100% { transform: scale(1.25); opacity: 0 } }
  @keyframes typing { 0%, 60%, 100% { transform: translateY(0); opacity: .55 } 30% { transform: translateY(-2.5px); opacity: 1 } }
  .links { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 26px }
  .links a, .links button { display: inline-flex; align-items: center; gap: 9px; text-decoration: none; color: var(--dim); border-bottom: 1px solid var(--line); padding-bottom: 5px; font: inherit; letter-spacing: inherit; text-transform: inherit; transition: color .2s, border-color .2s }
  .links svg { width: 15px; height: 15px; fill: currentColor }
  .links a:hover, .links button:hover { color: var(--ink); border-color: var(--amber) }
  .copy.done { color: var(--ok); border-color: var(--ok) }
  .mail { color: var(--mute); text-transform: none; margin-top: -18px }
  .sitefoot { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; padding: 24px var(--gutter); color: var(--dim); border-top: 1px solid var(--line); background: var(--carbon); position: relative; z-index: 2 }
  @media (max-width: 640px) { .sitefoot { flex-direction: column } }
  @media (prefers-reduced-motion: reduce) { .magnet .ring, .magnet .bubble .dot { animation: none } }
</style>
