---
import Tx from "./Tx.astro";
import { site, ui } from "@/data/portfolio";
import { ui2 } from "@/data/casos";
const [first, ...rest] = site.name.split(" ");
---
<!-- nombre gigante detrás del retrato -->
<div class="hero-back" aria-hidden="true">
  <div class="hero-name"><span class="row" data-split>{first}</span><span class="row" data-split>{rest.join(" ")}</span></div>
</div>

<!-- retrato -->
<div class="hero-figure">
  <div class="pic">
    <img
      src="/img/junior-1120.webp"
      srcset="/img/junior-720.webp 720w, /img/junior-1120.webp 1120w"
      sizes="(max-width: 640px) 100vw, 60vw"
      width="1120" height="989"
      alt={site.name}
      fetchpriority="high" decoding="async"
    />
  </div>
</div>

<section class="hero" data-gl="hero" aria-labelledby="hero-title">
  <h1 id="hero-title" class="sr-only">{site.name} — {site.role}</h1>
  <div class="hero-foot">
    <div class="hero-role" data-hero-in>
      {site.available && <a class="avail mono" href="#contacto"><span class="pulse" aria-hidden="true"></span><Tx t={ui2.available} /><span aria-hidden="true">→</span></a>}
      <b>{site.role}</b>
      <Tx as="p" t={ui2.heroP} />
      <div class="hero-cta">
        <a class="btn pri" href="#proyectos"><Tx t={ui2.heroCta} /><span aria-hidden="true">↓</span></a>
        <a class="btn sec" href="#cv"><Tx t={ui2.heroCv} /></a>
      </div>
    </div>
    <div class="scrollcue mono" data-hero-in><Tx t={ui.scroll} /><span class="bar"></span></div>
    <div class="hero-meta mono" data-hero-in>
      <span><strong>{site.location}</strong></span>
    </div>
  </div>
</section>

<style>
  .hero-back { position: absolute; top: 0; left: 0; right: 0; height: 100svh; min-height: 560px; z-index: 0; display: flex; align-items: center; justify-content: center; overflow: hidden; pointer-events: none }
  .hero-name { font-family: var(--display); font-weight: 900; text-transform: uppercase; line-height: .8; letter-spacing: -.01em; text-align: center; color: #1d2023; font-size: clamp(96px, 23vw, 400px); user-select: none }
  .hero-name .row { display: block; overflow: hidden; padding: 0 .02em }
  .hero-name :global(.ch) { display: inline-block; will-change: transform }
  .hero-name .row:last-child { color: transparent; -webkit-text-stroke: 1.5px #3a3f44 }

  /* retrato: delante del nombre, detrás de los textos; la parte baja se funde con el fondo */
  .hero-figure { position: absolute; top: 0; left: 0; right: 0; height: 100svh; min-height: 560px; z-index: 1; display: flex; align-items: flex-end; justify-content: center; overflow: hidden; pointer-events: none }
  .hero-figure::before { content: ""; position: absolute; left: 50%; top: 46%; width: min(70vw, 900px); aspect-ratio: 1; transform: translate(-50%, -50%);
    background: radial-gradient(closest-side, rgba(227, 154, 69, .16), rgba(227, 154, 69, .05) 55%, transparent 72%) }
  .hero-figure::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, var(--carbon) 0, rgba(13, 14, 15, .72) 13%, rgba(13, 14, 15, 0) 34%) }
  .pic { position: relative; animation: pic-in 1.4s var(--ease-out) .25s both }
  .pic img { height: min(84svh, 940px); min-height: 470px; width: auto; max-width: none;
    -webkit-mask-image: linear-gradient(to bottom, #000 56%, rgba(0, 0, 0, .55) 78%, transparent 97%); mask-image: linear-gradient(to bottom, #000 56%, rgba(0, 0, 0, .55) 78%, transparent 97%);
    filter: drop-shadow(-14px -4px 28px rgba(227, 154, 69, .22)) saturate(.96) contrast(1.04); will-change: transform }
  @keyframes pic-in { from { opacity: 0; transform: translateY(40px) scale(1.03) } to { opacity: 1; transform: none } }

  .hero { min-height: max(100svh, 560px); position: relative; display: grid; grid-template-rows: 1fr auto; padding: 110px var(--gutter) 32px }

  .hero-foot { grid-row: 2; display: grid; grid-template-columns: 1fr auto 1fr; align-items: end; gap: 24px; position: relative; z-index: 1 }
  .hero-role { max-width: 34ch }
  .hero-role b { display: block; font-family: var(--display); font-weight: 700; font-size: 28px; line-height: 1.05; letter-spacing: .01em; text-transform: uppercase; margin-bottom: 10px }
  .hero-role :global(p) { color: #b4bac0; font-size: 16px }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; pointer-events: auto }
  .btn { display: inline-flex; align-items: center; gap: 10px; padding: 12px 20px; border-radius: 99px; text-decoration: none; font-weight: 600; font-size: 15px; transition: background .25s, color .25s, border-color .25s, transform .2s }
  .btn:active { transform: scale(.97) }
  .btn.pri { background: var(--amber); color: var(--carbon) }
  .btn.pri:hover { background: var(--ink) }
  .btn.sec { border: 1px solid var(--line-strong); color: var(--ink) }
  .btn.sec:hover { border-color: var(--amber); color: var(--amber) }
  .scrollcue { display: flex; flex-direction: column; align-items: center; gap: 10px; color: var(--dim) }
  .scrollcue .bar { width: 1px; height: 46px; background: linear-gradient(var(--amber), transparent); animation: cue 2s ease-in-out infinite; transform-origin: top }
  @keyframes cue { 0% { transform: scaleY(0) } 50% { transform: scaleY(1) } 100% { transform: scaleY(0); transform-origin: bottom } }
  .avail { display: inline-flex; align-items: center; gap: 10px; width: max-content; margin-bottom: 14px; padding: 7px 14px 7px 12px; border-radius: 99px; font-size: 12px; letter-spacing: .04em; color: var(--ink); text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--ok) 45%, transparent); background: color-mix(in srgb, var(--ok) 10%, rgba(15, 16, 18, .7)); backdrop-filter: blur(6px); transition: border-color .3s, background .3s }
  .avail:hover, .avail:focus-visible { border-color: var(--ok); background: color-mix(in srgb, var(--ok) 18%, rgba(15, 16, 18, .7)) }
  .avail > span:last-child { transition: transform .3s var(--ease-out) } .avail:hover > span:last-child { transform: translateX(3px) }
  .pulse { position: relative; width: 8px; height: 8px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 10px var(--ok) }
  .pulse::after { content: ""; position: absolute; inset: 0; border-radius: 50%; background: var(--ok); animation: pulse 1.8s ease-out infinite }
  @keyframes pulse { to { transform: scale(3); opacity: 0 } }
  @media (prefers-reduced-motion: reduce) { .pulse::after { animation: none } }
  .hero-meta { justify-self: end; text-align: right; color: var(--dim); display: grid; gap: 4px }
  .hero-meta strong { color: var(--ink); font-weight: 500 }
  .hero-meta :global(.status) { display: inline-flex; align-items: center; justify-content: flex-end; gap: 8px; color: var(--ink) }
  .hero-meta :global(.status)::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 10px var(--ok) }

  @media (max-width: 980px) {
    .pic img { height: min(70svh, 760px) }
  }
  @media (max-width: 640px) {
    .hero-back { align-items: flex-start; padding-top: 112px }
    .hero-figure { align-items: flex-start; padding-top: 64px }
    .pic img { height: auto; width: 118vw; min-height: 0; -webkit-mask-image: linear-gradient(to bottom, #000 50%, transparent 92%); mask-image: linear-gradient(to bottom, #000 50%, transparent 92%) }
    .hero-foot { grid-template-columns: 1fr; gap: 20px }
    .scrollcue { display: none }
    .hero-meta { justify-self: start; text-align: left }
    .hero-meta :global(.status) { justify-content: flex-start }
  }
  @media (prefers-reduced-motion: reduce) { .pic { animation: none } }
</style>
