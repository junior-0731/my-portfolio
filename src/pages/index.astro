---
import Base from "@/layouts/Base.astro";
import Nav from "@/components/Nav.astro";
import Hero from "@/components/Hero.astro";
import Manifesto from "@/components/Manifesto.astro";
import Projects from "@/components/Projects.astro";
import Team from "@/components/Team.astro";
import Cv from "@/components/Cv.astro";
import Videos from "@/components/Videos.astro";
import Stack from "@/components/Stack.astro";
import Timeline from "@/components/Timeline.astro";
import Contact from "@/components/Contact.astro";
import Terminal from "@/components/Terminal.astro";
import CoffeeCup from "@/components/CoffeeCup.astro";
---
<Base>
  <div class="grain" aria-hidden="true"></div>
  <div class="cursor" aria-hidden="true"></div>

  <Hero />
  <Nav />
  <main id="top">
    <Manifesto />
    <Projects />
    <Terminal />
    <Videos />
    <Stack />
    <Timeline />
    <Cv />
    <Team />
    <Contact />
  </main>
  <CoffeeCup />
</Base>

<script>
  import "@/scripts/main";
</script>

<style is:global>
  main { position: relative; z-index: 2 }
  /* la sección hero queda encima del nombre gigante y del retrato */
  .hero { z-index: 2 }

  .grain { position: fixed; inset: -50%; z-index: 50; pointer-events: none; opacity: .06;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    animation: grain 1.2s steps(6) infinite }
  @keyframes grain { 0% { transform: translate(0, 0) } 25% { transform: translate(-3%, 2%) } 50% { transform: translate(2%, -3%) } 75% { transform: translate(-2%, -1%) } 100% { transform: translate(0, 0) } }

  .cursor { opacity: 0; position: fixed; left: 0; top: 0; width: 36px; height: 36px; margin: -18px 0 0 -18px; border: 1px solid rgba(236, 232, 226, .6); border-radius: 50%; z-index: 60; pointer-events: none; transition: width .25s, height .25s, margin .25s, background .25s, border-color .25s; display: none }
  .cursor.big { width: 76px; height: 76px; margin: -38px 0 0 -38px; background: rgba(227, 154, 69, .12); border-color: var(--amber) }
  .cursor.drag { width: 96px; height: 96px; margin: -48px 0 0 -48px; border-style: dashed; border-color: var(--amber) }
  @media (hover: hover) and (pointer: fine) { .cursor { display: block } }

  @media (prefers-reduced-motion: reduce) { .grain { animation: none } }
</style>
